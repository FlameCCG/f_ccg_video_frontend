{
  "name": "bilibili-video-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "prettier": "prettier --write \"src/**/*.{vue,ts,tsx,js,jsx,css}\"",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit --project tsconfig.app.json",
    "stylelint": "stylelint \"src/**/*.{css,vue}\" --max-warnings 0",
    "stylelint:fix": "stylelint \"src/**/*.{css,vue}\" --fix",
    "check:commit": "pnpm -s lint && pnpm -s typecheck && pnpm -s stylelint"
  },
  "dependencies": {
    "@vee-validate/zod": "^4.15.0",
    "@vueuse/core": "^14.1.0",
    "artplayer": "^5.2.1",
    "artplayer-plugin-danmuku": "^5.1.4",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.0.0",
    "hash-wasm": "^4.12.0",
    "lucide-vue-next": "^0.511.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.2.0",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.7.0",
    "tailwind-merge": "^3.3.0",
    "vee-validate": "^4.15.0",
    "vite-plugin-oh-my-live2d": "^0.19.3",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
